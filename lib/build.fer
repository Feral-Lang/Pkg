# Generate CMakeLists.txt and build/install it.

let io = import('std/io');
let fs = import('std/fs');
let os = import('std/os');
let map = import('std/map');
let fecl = import('std/fecl');
let logging = import('std/logging');
let version = import('std/version');

let core = import('./core');
let lock = import('./lock');
let install = import('./install');

let handle = fn(sub) {
    let dirStr = sub.getValue('dir');
    let dir = os.getCWD();
    if !dirStr.empty() { dir = dirStr.path(); }
    return build(dir);
};

let build = fn(dir) {
    logging.trace('[build] building package in ', dir);
    io.cprintln('{y}Building package in {c}', dir, ' {0}...');
    let pkg = core.getPkgFromScriptIn(dir);
    if pkg == nil { return false; }
    let lockData = core.getLockFromFileIn(dir);
    if lockData == nil {
        logging.trace('[cmake] no lock file found to generate CMakeLists.txt in ', dir);
        io.cprintln('{br}FATAL{0}: {y}No lock file found to generate {c}CMakeLists.txt {y}in {c}', dir, '{0}!');
        return false;
    }
    let deps = ref(lockData['deps']);
    let depInfo = getDependencyInfo(deps);
    if depInfo == nil {
        logging.trace('[cmake] failed to get dependency info for package in ', dir);
        return false;
    }
    let vers = version.parse(pkg.version);
    let cmakeListsPath = dir / 'CMakeLists.txt';
    let f = fs.fopen(cmakeListsPath, 'w+');
    io.fprintln(f, baseTemplate.fmt());
    return true;
};

let getDependencyInfo = fn(lockDeps) {
    let depInfo = DependenceInfo();
    for dep in lockDeps.each() {
        if dep.isFeral {
            continue;
        }
        let vers = dep.constraint;
        while !vers.empty() && !vers[0].isDigit() { vers.erase(0); }
        if !isNativePackageInstalled(dep.name, vers) {
            io.cprintln('{br}FATAL{0}: {y}Could not find native dependency on system {c}', dep.name, '{0}@{c}', vers, '{0}!');
            return nil;
        }
        depInfo.findPackage += 'find_package(' + dep.name + ' ' + vers + ' REQUIRED)\n';
    }
    return depInfo;
};

let isNativePackageInstalled = fn(pkgName, pkgVersion) {
    logging.trace('[cmake] checking if the native package ', pkgName, '@', pkgVersion, ' is installed');
    io.cprint('- {y}Checking if native package {c}', pkgName, '{0}@{c}', pkgVersion, ' {y}exists {0}... ');
    let out = '';
    let res = os.exec(out = out, core.cmakeCmd, '-S', cmakePkgTestTempRoot, '-B', cmakePkgTestTempRoot / ('build-' + pkgName),
                      '-DpkgName=' + pkgName, '-DpkgVersion=' + pkgVersion, '^2>&1', '^>' + io.null);
    if res != 0 {
        logging.trace('[cmake] could not find native package ', pkgName, '@', pkgVersion);
        io.cprintln('{br}no{0}!');
        return false;
    }
    logging.trace('[cmake] found native package ', pkgName, '@', pkgVersion);
    io.cprintln('{g}yes{0}!');
    return true;
};

let baseTemplate =
`
cmake_minimum_required(VERSION $<<feral.minCmakeVersion>>)

project($<<pkg.name>>
    DESCRIPTION "$<<pkg.desc>>"
    LANGUAGES C CXX)

set(PROJECT_VERSION_MAJOR "$<<vers.major>>")
set(PROJECT_VERSION_MINOR "$<<vers.minor>>")
set(PROJECT_VERSION_PATCH "$<<vers.patch>>")

include(FetchContent)
include(GNUInstallDirs)
include(CheckCXXCompilerFlag)
include(CMakePackageConfigHelpers)

if("${DISABLE_INSTALL_MSG}" STREQUAL "true")
    message("-- Install messages are now lazily shown")
    set(CMAKE_INSTALL_MESSAGE LAZY)
endif()

if("${ENABLE_ASAN}" STREQUAL "true")
    message("-- Address sanitizer is now enabled")
    set(CMAKE_CXX_FLAGS "${CMAKE_CXX_FLAGS} -fsanitize=address")
endif()

if("${ENABLE_TSAN}" STREQUAL "true")
    message("-- Thread sanitizer is now enabled")
    set(CMAKE_CXX_FLAGS "${CMAKE_CXX_FLAGS} -fsanitize=thread")
endif()

# Add external path
set(CMAKE_MODULE_PATH
    "${PROJECT_SOURCE_DIR}/cmake"
    $<<depInfo.findPackagePaths
    "$<<feral.libPath>>/cmake/Feral"
    "$<<feral.libPath>>/cmake/LibCore"
    ${CMAKE_MODULE_PATH}
)

# find packages
$<<depInfo.findPackage>>

set(CMAKE_MSVC_DEBUG_INFORMATION_FORMAT "$<$<CONFIG:Debug,RelWithDebInfo>:Embedded>")

set(CMAKE_INSTALL_PREFIX "$<<core.installRoot>>/$<<pkg.name>>-$<<pkg.version>>")
set(CMAKE_PREFIX_PATH "${CMAKE_INSTALL_PREFIX};${CMAKE_BINARY_DIR}")
set(CMAKE_INSTALL_RPATH "${CMAKE_INSTALL_PREFIX}/lib")

add_definitions(-DINSTALL_PREFIX=${CMAKE_INSTALL_PREFIX})
message("-- Using PREFIX = ${CMAKE_INSTALL_PREFIX}")

if(WIN32)
    # Disable deprecated warnings on Windows
    if(CMAKE_CXX_COMPILER_ID STREQUAL "Clang")
        add_compile_options("-Wno-deprecated-declarations")
    endif()
    if("${CCACHE_PROGRAM}" STREQUAL "")
        find_program(CCACHE_PROGRAM sccache)
    endif()
else()
    if(NOT APPLE)
        set(CMAKE_INSTALL_RPATH_USE_LINK_PATH TRUE)
    endif()
    if("${CCACHE_PROGRAM}" STREQUAL "")
        find_program(CCACHE_PROGRAM ccache)
    endif()
endif()
if(CCACHE_PROGRAM)
    set(CMAKE_C_COMPILER_LAUNCHER "${CCACHE_PROGRAM}")
    set(CMAKE_CXX_COMPILER_LAUNCHER "${CCACHE_PROGRAM}")
    message("-- Using ccache: ${CCACHE_PROGRAM}")
endif()

# For macOS and BSD
if(APPLE OR ${CMAKE_SYSTEM_NAME} MATCHES ".*BSD.*")
    include_directories(/usr/local/include)
    if(NOT APPLE)
        add_definitions(-D_WITH_GETLINE)
    endif()
endif()

set(CMAKE_THREAD_PREFER_PTHREAD TRUE)
set(THREADS_PREFER_PTHREAD_FLAG ON)
find_package(Threads REQUIRED)
if(CMAKE_USE_PTHREADS_INIT)
    message("-- Using thread flags: -pthread")
    set(CMAKE_CXX_FLAGS  "${CMAKE_CXX_FLAGS} -pthread")
    set(CMAKE_EXE_LINKER_FLAGS  "${CMAKE_EXE_LINKER_FLAGS} -pthread")
else()
    message("-- Using thread flags: ${CMAKE_THREAD_LIBS_INIT}")
    set(CMAKE_CXX_FLAGS  "${CMAKE_CXX_FLAGS} ${CMAKE_THREAD_LIBS_INIT}")
    set(CMAKE_EXE_LINKER_FLAGS  "${CMAKE_EXE_LINKER_FLAGS} ${CMAKE_THREAD_LIBS_INIT}")
endif()

# Generally, disabled for CI purposes
# Also needed when running valgrind as valgrind does not support instruction bytes for Vector<bool>
if(NOT DEFINED ENV{DISABLE_MARCH_NATIVE} OR "$ENV{DISABLE_MARCH_NATIVE}" STREQUAL "")
    check_cxx_compiler_flag(-march=native COMPILER_SUPPORTS_MARCH_NATIVE)
    if(COMPILER_SUPPORTS_MARCH_NATIVE)
        set(CMAKE_CXX_FLAGS "${CMAKE_CXX_FLAGS} -march=native")
    endif()
endif()

# Force DWARF4 as valgrind does not support anything newer (clang-14 defaults to DWARF5).
if(NOT CMAKE_BUILD_TYPE STREQUAL "Release")
    check_cxx_compiler_flag(-gdwarf-4 COMPILER_SUPPORTS_GDWARF4)
    if(COMPILER_SUPPORTS_GDWARF4)
        set(CMAKE_CXX_FLAGS "${CMAKE_CXX_FLAGS} -gdwarf-4")
    endif()
endif()

if(CMAKE_COMPILER_IS_GNUCXX AND DEFINED WITH_COVERAGE)
    set(WITH_COVERAGE "-D_WITH_COVERAGE")
    include(CodeCoverage)
    APPEND_COVERAGE_COMPILER_FLAGS()
    setup_target_for_coverage_gcovr_html(NAME feral_cov EXECUTABLE ${PROJECT_SOURCE_DIR}/codecov.sh ${PROJECT_SOURCE_DIR})
endif()

# Finally! The sources!!!!!

<<libraries>>

<<install>>

# Install Feral Imports
install(DIRECTORY "${CMAKE_SOURCE_DIR}/lib/"
    DESTINATION "${CMAKE_INSTALL_LIBDIR}/$<<pkg.name>>"
    FILES_MATCHING PATTERN "*.fer" PATTERN "*.hpp"
)

<<installBinaries>>
`;

let cmakePkgTestTemplate =
`
`;