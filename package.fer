let vec = import('std/vec');
let package = import('std/package');

let configure = fn(info) {
    let pkg = package.new(
        'Pkg',
        desc = 'Feral package manager',
        version = '0.3.0',
        feral = '>=2.7.0',
        authors = vec.new(
            'Electrux'
        )
    );

    pkg.addConfigFile(info.pkgRoot / 'lib' / 'core.fer.in', info.pkgRoot / 'lib' / 'core.fer');

    return feral.ok(pkg);
};