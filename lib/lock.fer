# Generate lockfiles using the package + dependency information in package.fer in current directory.
# Format:
#   deps = [
#       { name = '...'; constraint = '...'; url = '...'; sha256 = '...'; };
#       ...
#   ];

let io = import('std/io');
let fs = import('std/fs');
let os = import('std/os');
let map = import('std/map');
let vec = import('std/vec');
let fecl = import('std/fecl');
let package = import('std/package');
let version = import('std/version');

let core = import('./core');
let index = import('./index');

let handle = fn(sub) {
    return generate(os.getCWD());
};

let generate = fn(dir) {
    let _ = core.logger.scopedTag('lockGenerate');
    core.logger.info('generating lock file in `', dir, '`');
    io.cprintln('{y}generating lock file in {c}', dir, ' {0}...');
    let lockFilePath = package.getLockPath(dir);
    let pkgRes = core.loadPkgScriptIn(dir);
    if pkgRes.isErr() {
        core.logger.fatal('failed to load package script in `', dir, '`:');
        io.cprintln('{br}FATAL{0}: {y}failed to load package script in {c}', dir, '{0}:');
        io.cprintln(pkgRes.val().msg());
        return false;
    }
    let pkg = pkgRes.val();
    let depsRes = fetchAllDependencies(pkg);
    if depsRes.isErr() {
        core.logger.fatal('failed to fetch dependencies:');
        io.cprintln('{br}FATAL{0}: {y}failed to fetch dependencies while generating lock file{0}:');
        io.cprintln(depsRes.val().msg());
        return false;
    }
    let deps = depsRes.val();
    let outMap = map.new(refs = true, 'deps', deps);
    let f = fs.fopen(lockFilePath, 'w+');
    io.fprintln(f, fecl.dumps(outMap, 0, '    '));
    core.logger.info('generated lock file `', lockFilePath, '`');
    io.cprintln('{g}generated lock file {c}', lockFilePath, '{0}!');
    return true;
};

let fetchAllDependencies = fn(pkg) {
    let _ = core.logger.scopedTag('lockFetchAllDependencies');
    let deps = vec.new(refs = true);
    for d in pkg.dependencies.each() {
        if !d.isFeral {
            let depMap = map.new(
                'name', d.name,
                'constraint', d.constraint,
                'url', '',
                'sha256', '',
                'isFeral', false
            );
            deps.push(depMap);
            continue;
        }
        let installedVersionRes = index.getInstalled(d.name.lower(), constraint = d.constraint);
        inline if installedVersionRes.isErr() {
        let viableVersion = index.lookup(d.name.lower(), constraint = d.constraint).?;
        } else {
        let viableVersion = installedVersionRes.val();
        }
        let subDeps = getPackageDependencies(d.name, viableVersion, installedVersionRes.isOk()).?;
        for s in subDeps.each() {
            let found = false;
            for dep in deps.each() {
                if dep.name == s.name {
                    found = true;
                    let cons = version.intersect(dep.constraint, s.constraint);
                    if cons == nil {
                        core.logger.fatal('could not resolve dependency conflict for ', dep.name, '; existing constraint: ', dep.constraint, ', constraint from dependency of ', d.name, ': ', s.constraint);
                        return feral.err(-1, '{y}encountered a dependency conflict for {c}', dep.name, '{0}:\n' +
                                             '       {y}a previous package requires {c}', dep.constraint, '{0},\n' +
                                             '       {c}', d.name, '{y} requires {c}', s.constraint, '{0}!');
                    }
                    dep.constraint = cons;
                    break;
                }
            }
            if found { continue; }
            deps.push(s);
        }
        let depMap = map.new(
            'name', d.name,
            'constraint', d.constraint,
            'url', viableVersion.url,
            'sha256', viableVersion.sha256,
            'isFeral', true
        );
        deps.push(depMap);
    }
    return feral.ok(deps);
};

let getPackageDependencies = fn(name, versionInfo, isInstalled) {
    let _ = core.logger.scopedTag('lockGetPackageDependencies');
    let pkgDir = ''.path();
    if isInstalled {
        pkgDir = package.getInstallPath(name, versionInfo.version);
    } else {
        pkgDir = core.downloadAndExtract(name, versionInfo.version, versionInfo.url, versionInfo.sha256).?;
    }
    let lockInfo = core.loadLockFileIn(pkgDir).?;
    return feral.ok(lockInfo['deps']);
};
