let io = import('std/io');
let fs = import('std/fs');
let os = import('std/os');
let vec = import('std/vec');

let core = import('./core');

# API to use
let handle = fn(sub) {
    let _ = core.logger.scopedTag('initHandle');

    let name = sub.getValue('name');
    let version = sub.getValue('version');
    let feralConstr = sub.getValue('feral');
    let desc = sub.getValue('desc');
    let withBin = sub.has('bin');
    let author = getAuthor(sub);

    let projDir = os.getCWD();

    if name.empty() {
        name = projDir.fileName().str();
    }

    if fs.exists(projDir / 'package.fer') {
        core.logger.fatal('package already exists in `', projDir, '`; won\'t continue!');
        io.cprintln('{br}FATAL{0}: {y}a package already exists here{0}!');
        return false;
    }
    fs.mkdir(projDir / 'tests');
    writeLibStub(projDir, name);
    writeGitIgnore(projDir, name);
    if withBin { writeBinStub(projDir, name); }
    writePackageScript(projDir, name, desc, version, feralConstr, author);
    core.logger.info('created package `', name, '` at `', projDir, '`');
    io.cprintln('{g}successfully created package {c}', name, ' {g}in {c}', projDir, '{0}!');
    return true;
};

let getAuthor = fn(sub) {
    let _ = core.logger.scopedTag('initGetAuthor');

    let author = sub.getValue('author');
    if !author.empty() {
        core.logger.info('using provided author: ', author);
        return author;
    }
    let name = '';
    let email = '';
    os.exec(core.gitCmd, 'config', 'user.name', out = name);
    os.exec(core.gitCmd, 'config', 'user.email', out = email);
    if name.empty() && email.empty() {
        core.logger.info('no git user/email found, using a default string');
        return 'TODO: add author';
    }
    core.logger.info('using git user.name = ', name, '; user.email = ', email);
    if email.empty() { return name; }
    if name.empty() { return email; }
    return name + ' <' + email + '>';
};

let writeBinStub = fn(dir, name) {
    let _ = core.logger.scopedTag('initWriteBinStub');

    fs.mkdir(dir / 'bin');
    let p = dir / 'bin' / (name.lower() + '.fer');
    if fs.exists(p) { return true; }
    core.logger.info('- writing bin stub: ', p);
    let f = fs.fopen(p, 'w+');
    io.fprintln(f, '# Executable file for the package ', name, ' generated by Feral package manager');
    core.logger.info('- finished writing bin stub');
    return true;
};

let writeLibStub = fn(dir, name) {
    let _ = core.logger.scopedTag('initWriteLibStub');

    fs.mkdir(dir / 'lib');
    let p = dir / 'lib' / (name.lower() + '.fer');
    if fs.exists(p) { return true; }
    core.logger.info('- writing lib stub: ', p);
    let f = fs.fopen(p, 'w+');
    io.fprintln(f, '# Importable file for the package ', name, ' generated by Feral package manager');
    core.logger.info('- finished writing lib stub');
    return true;
};

let writeGitIgnore = fn(dir, name) {
    let _ = core.logger.scopedTag('initWriteGitIgnore');

    let toIgnore = vec.new(refs = true, 'build/', '.cache/', 'compile_commands.json');

    let p = dir / '.gitignore';
    core.logger.info('- writing gitignore', p);
    if fs.exists(p) {
        core.logger.info('- .gitignore already exists, verifying data');
        let dataLines = fs.fopen(p, 'r').lines();
        let f = fs.fopen(p, 'a+');
        for ignore in toIgnore.each() {
            if dataLines.find(ignore) { continue; }
            io.fprintln(f, ignore);
            core.logger.info('-- added `', ignore, '` to .gitignore');
        }
        core.logger.info('- finished updating .gitignore');
        return true;
    }
    let f = fs.fopen(p, 'w+');
    io.fprintln(f, '# Default gitignore, generated by Feral package manager');
    for ignore in toIgnore.each() {
        io.fprintln(f, ignore);
        core.logger.info('-- added `', ignore, '` to .gitignore');
    }
    core.logger.info('- finished writing .gitignore');
    return true;
};

let writePackageScript = fn(dir, name, desc, version, feralConstr, author) {
    let _ = core.logger.scopedTag('initWritePackageScript');

    let p = dir / 'package.fer';

    core.logger.info('- writing package script ', p);

    let f = fs.fopen(p, 'w+');
    io.fprintln(f, "let vec = import('std/vec');");
    io.fprintln(f, "let package = import('std/package');");
    io.fprintln(f, "");
    io.fprintln(f, "let configure = fn(info) {");
    io.fprintln(f, "    let pkg = package.new(");
    io.fprintln(f, "        '", name, "',");
    io.fprintln(f, "        desc = '", desc, "',");
    io.fprintln(f, "        version = '", version, "',");
    io.fprintln(f, "        feral = '", feralConstr, "',");
    io.fprintln(f, "        author = vec.new('", author, "')");
    io.fprintln(f, "    );");
    io.fprintln(f, "");
    io.fprintln(f, "    # Sample C library dependency");
    io.fprintln(f, "    # pkg.requires('CURL', version = '~3.0.0');");
    io.fprintln(f, "    # Sample Feral library dependency");
    io.fprintln(f, "    # pkg.requires('Progress', version = '>=0.1.0', feral = true);");
    io.fprintln(f, "");
    io.fprintln(f, "    # `info.pkgRoot` contains the package root directory and can be used");
    io.fprintln(f, "    # to work with paths/files relative to the package root.");
    io.fprintln(f, "");
    io.fprintln(f, "    # Sample C++ extension provided by this project");
    io.fprintln(f, "    # let ", name, "Target = pkg.addTarget('", name, "');");
    io.fprintln(f, "    # ", name, "Target.findHeaders(info.pkgRoot / 'lib', '(.*).hpp');");
    io.fprintln(f, "    # ", name, "Target.addSources('", name, ".cpp');");
    io.fprintln(f, "");
    io.fprintln(f, "    return feral.ok(pkg);");
    io.fprintln(f, "};");

    core.logger.info('- finished writing package script');
    return true;
};