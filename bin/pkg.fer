let io = import('std/io');
let logging = import('std/logging');
let argparse = import('std/argparse');

let pkgCore = import('pkg/core');

let p = argparse.new('Pkg', 'The Feral package manager');
let subs = p.addSubparsers('command');

let initSub = subs.add('init', 'Initialize a package in the current directory');
initSub.addPos('name').setDefault('').setHelp('Package name');
initSub.addFlag('bin').addOpts('--bin').setHelp('Also create a bin/ directory for executable scripts');
initSub.addOpt('version').addOpts('--version').setDefault('0.0.1').setHelp('Initial version');
initSub.addOpt('feral').addOpts('--feral').setDefault('>=' + feral.version).setHelp('Minimum Feral version constraint (default: >=<current version>)');
initSub.addOpt('author').addOpts('--author').setHelp('Author "Name <email>" (default: from git config)');
initSub.addOpt('desc').addOpts('--desc').setDefault('TODO: add description').setHelp('Short package description');

subs.add('lock', 'Resolve dependencies and generate package.lock');
subs.add('list', 'Show all installed packages');
subs.add('clean', 'Remove all dangling installed packages - which are no longer needed');

let installSub = subs.add('install', 'Install a package and all dependencies from package.fer / package.lock');
installSub.addPos('name').setNargs(-1).setReqd(false).setHelp('Package name (omit to install from $PWD/package.fer)');
installSub.addOpt('type').addOpts('--type').setDefault(feral.buildType.lower()).setHelp('Build type: debug/release/relwithdebinfo (default: ' + feral.buildType.lower() + ')');

let uninstallSub = subs.add('uninstall', 'Uninstall an installed package');
uninstallSub.addPos('name').setNargs(-1).setReqd(false).setHelp('Package name (omit to install from $PWD/package.fer)');

let indexSub = subs.add('index', 'Manage package indices');
let indexSubSubs = indexSub.addSubparsers('indexcmd');
let indexAddSub = indexSubSubs.add('add', 'Register a new index');
indexAddSub.addPos('url').setReqd(true).setHelp('Index URL');
let indexRemoveSub = indexSubSubs.add('remove', 'Remove a registered index');
indexRemoveSub.addPos('url').setReqd(true).setHelp('Index URL');
let indexUpdateSub = indexSubSubs.add('update', 'Update an index (or all indices if no URL given)');
indexUpdateSub.addPos('url').setReqd(false).setHelp('Index URL (omit to update all)');
indexSubSubs.add('list', 'List all registered indices');

p.parse(feral.args);

let logger = logging.newLogger();
logger.addTargetByPath(pkgCore.logFile, level = logging.Levels.TRACE);
pkgCore.setLogger(logger);

let cmd = p.getSubcmd();
let sub = p.getSubparser();

if cmd == 'index' {
    let pkgIndex = import('pkg/index');
    feral.exit(pkgIndex.handle(sub) ? 0 : 1);
} elif cmd == 'init' {
    let pkgInit = import('pkg/init');
    feral.exit(pkgInit.handle(sub) ? 0 : 1);
} elif cmd == 'list' {
    let pkgList = import('pkg/list');
    feral.exit(pkgList.handle(sub) ? 0 : 1);
} elif cmd == 'lock' {
    let pkgLock = import('pkg/lock');
    feral.exit(pkgLock.handle(sub) ? 0 : 1);
} elif cmd == 'install' {
    let pkgInstall = import('pkg/install');
    feral.exit(pkgInstall.handle(sub) ? 0 : 1);
} elif cmd == 'uninstall' {
    let pkgUninstall = import('pkg/uninstall');
    feral.exit(pkgUninstall.handle(sub) ? 0 : 1);
} elif cmd == 'clean' {
    let pkgClean = import('pkg/clean');
    feral.exit(pkgClean.handle(sub) ? 0 : 1);
}
if !pkgCore.hasHandler(cmd) {
    p.printHelp();
    feral.exit(1);
}
if !pkgCore.handle(cmd, sub) { feral.exit(1); }
