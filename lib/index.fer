# Manage indexes used by the Package Manager
# Each package in the index has following format (from latest to oldest):
#   versions = [
#       { version = '2.0.0', url = '...'; sha = '...'; };
#       { version = '0.1.2', url = '...'; sha = '...'; };
#       { version = '0.1.1', url = '...'; sha = '...'; };
#       { version = '0.1.0', url = '...'; sha = '...'; };
#   ];

let io = import('std/io');
let fs = import('std/fs');
let os = import('std/os');
let map = import('std/map');
let vec = import('std/vec');
let fecl = import('std/fecl');
let term = import('std/term');
let time = import('std/time');
let version = import('std/version');

let core = import('./core');

let handle = fn(sub) {
    let cmd = sub.getSubcmd();
    let ssub = sub.getSubparser();

    loadState();

    if cmd == 'add' {
        return add(ssub.getValue('url'));
    } elif cmd == 'remove' {
        return remove(ssub.getValue('url'));
    } elif cmd == 'update' {
        let url = ssub.getValue('url');
        if url == '' {
            return updateAll();
        } else {
            return update(url, urlToDir(url));
        }
    } elif cmd == 'list' {
        return listAll();
    }
    return false;
};

let add = fn(url) {
    let _ = core.logger.scopedTag('indexAdd');
    let dir = urlToDir(url);
    if fs.exists(dir) {
        core.logger.info('index `', url, '` already exists!');
        io.cprintln('{g}index {c}', url, '{g} already exists{0}!');
        return true;
    }
    fs.mkdir(dir);
    core.logger.trace('cloning index repository `', url, '`');
    io.cprint('{y}cloning index repository {0}... ');
    io.fflush(io.stdout);
    let out = vec.new(refs = true);
    let res = os.exec(out = out, core.gitCmd, 'clone', '--depth=1', url, dir.str(), '^2>&1');
    if res != 0 {
        core.logger.fatal('failed to clone index repository:');
        io.println();
        io.cprintln('{br}FATAL{0}: {y}failed to clone index repository{0}:');
        let _ = core.logger.ScopedDepth();
        for o in out.each() {
            core.logger.fatal(o);
            io.println('- ', o);
        }
        return false;
    }
    let name = dir.file().str();
    if !markIndexUpdated(name) {
        core.logger.fatal('failed to mark index in `', dir, '` as updated');
        io.println();
        io.cprintln('{br}FATAL{0}: {y}failed to mark index in {c}', dir, ' {y}as updated{0}!');
        return false;
    }
    core.logger.info('index `', url, '` added successfully!');
    io.cprintln('{g}success{0}!');
    return true;
};

let remove = fn(url) {
    let _ = core.logger.scopedTag('indexRemove');
    let dir = urlToDir(url);
    core.logger.info('removing index with url `', url, '`');
    io.cprint('{y}removing index {c}', url, ' {0}... ');
    if !fs.exists(dir) {
        core.logger.info('index `', url, '` does not exist at `', dir, '`');
        io.println();
        io.cprintln('{br}FATAL{0}: {y}path for index {c}', url, ' {y}does not exist{0}!');
        return false;
    }
    fs.remove(dir);
    core.logger.info('removed repository in `', dir, '`');
    io.cprintln('{g}success{0}!');
    return true;
};

let update = fn(url, dir) {
    let _ = core.logger.scopedTag('indexUpdate');
    core.logger.info('updating index in `', dir, '`');
    io.cprint('{y}updating index {c}', url, ' {0}... ');
    if !fs.exists(dir) {
        core.logger.fatal('index `', url, '` does not exist at `', dir, '`');
        io.println();
        io.cprintln('{br}FATAL{0}: {y}path for index {c}', url, ' {y}does not exist{0}!');
        return false;
    }
    core.logger.debug('pulling repository in ', dir);
    let out = vec.new(refs = true);
    let res = os.exec(out = out, core.gitCmd, '-C', dir.str(), 'pull', '^2>&1');
    if res != 0 {
        core.logger.fatal('failed to pull repository, error:');
        let _ = core.logger.ScopedDepth();
        for o in out.each() {
            core.logger.fatal(o);
        }
        io.println();
        io.cprintln('{br}FATAL{0}: {y}failed to update index repository{0}, {y}error{0}:');
        io.println(out.join('\n'));
        return false;
    }
    let name = dir.file().str();
    if !markIndexUpdated(name) {
        core.logger.fatal('failed to mark the index as updated');
        io.println();
        io.println('{br}FATAL{0}: {y}failed to mark the index as updated{0}!');
        return false;
    }
    core.logger.info('pulled repository in `', dir, '`');
    io.cprintln('{g}success{0}!');
    return true;
};

let updateAll = fn() {
    let _ = core.logger.scopedTag('indexUpdateAll');
    let dirs = fs.walkDir(core.indexRoot, fs.WALK_DIRS);
    core.logger.info('updating all indices');
    io.cprintln('{y}updating all indices {0}... ');
    if dirs.empty() {
        core.logger.info('no index directory present to update');
        io.cprintln('{g}no index setup in {c}', core.indexRoot, ' {g}to update{0}!');
        return true;
    }
    let failed = 0;
    for dir in dirs.each() {
        io.print('- ');
        if !update(dirToUrl(dir), dir) { ++failed; }
    }
    if failed > 0 {
        core.logger.fatal('failed to update `', failed, '` repositories');
        io.cprintln('{br}FATAL{0}: {y}failed to update {c}', failed, ' {y}index repositories{0}!');
        return false;
    }
    core.logger.info('update all repositories');
    io.cprintln('{g}successfully updated all repositories{0}!');
    return true;
};

let listAll = fn() {
    let _ = core.logger.scopedTag('indexListAll');
    let dirs = fs.walkDir(core.indexRoot, fs.WALK_DIRS);
    core.logger.info('listing all `', dirs.len(), '` indices');
    if dirs.empty() {
        core.logger.warn('no index setup in `', core.indexRoot, '` to list!');
        io.cprintln('{y}no index setup in {c}', core.indexRoot, ' {y}to list{0}!');
        return true;
    }
    let __ = core.logger.scopedDepth();
    for d in dirs.each() {
        core.logger.info(dirToUrl(d), ' => ', d);
        io.cprintln('- {c}', dirToUrl(d), '{0} => {y}', d, '{0}');
    }
    return true;
};

let lookup = fn(name, .kw) {
    let meta = lookupMeta(name).?;
    return lookupInMeta(meta, name, kw...);
};

let lookupMeta = fn(name) {
    let _ = core.logger.scopedTag('indexLookupMeta');
    let dirs = fs.walkDir(core.indexRoot, fs.WALK_DIRS);
    core.logger.info('looking up ', name, ' in indexes');
    if dirs.empty() {
        core.logger.warn('[indexLookupMeta] no index available to lookup package: ', name);
        return feral.err(-1, 'no index available to lookup package');
    }
    for d in dirs.each() {
        let metaPath = getPkgMetaPath(d, name);
        if !fs.exists(metaPath) { continue; }
        core.logger.trace('found metadata for ', name, ' in index ', dirToUrl(d));
        let meta = fs.fopen(metaPath, 'r').readAll();
        return feral.ok(fecl.loads(meta));
    }
    core.logger.fatal('could not find metadata for ', name);
    return feral.err(-1, 'could not find metadata');
};

let lookupInMeta = fn(meta, name, .kw) {
    let _ = core.logger.scopedTag('indexLookupInMeta');
    if meta == nil { raise('provided `meta` is `nil`'); }
    let versions = ref(meta['versions']);
    if versions == nil || versions.empty() {
        core.logger.fatal('no version info available in metadata for `', name, '`');
        return feral.err(-1, 'no versions info available in meta');
    }
    let vers = kw['version'];
    let constraint = kw['constraint'];
    let current = kw['current'] ?? false;
    if vers != nil {
        for v in versions.each() {
            if v.version == vers { return feral.ok(v); }
        }
        core.logger.fatal('could not find `', name, '@', vers, '` in metadata');
        return feral.err(-1, 'could not find package `', name, '@', vers, '` in metadata');
    }
    if constraint != nil {
        let all = kw['all'] ?? false;
        let res = vec.new(refs = true);
        let cons = version.parseConstraint(constraint);
        for v in versions.each() {
            let vObj = version.parse(v.version);
            if cons.matches(vObj) { res.push(v); }
        }
        if res.empty() {
            core.logger.fatal('could not find ', name, ' with constraint ', constraint);
            return feral.err(-1, 'could not find package `', name, '` satisfying constraint `', constraint, '`');
        }
        return feral.ok(all ? res : res[0]);
    }
    return feral.ok(current ? versions[0] : versions);
};

####################################################################################################
############################################ State #################################################
####################################################################################################

let statePath = core.indexRoot / 'state.fecl';
let stateUpdateInterval = time.to(time.second, days = 7);

let state = map.new();

let loadState = fn() {
    let _ = core.logger.scopedTag('indexLoadState');
    if !fs.exists(statePath) {
        core.logger.debug('no state currently exists at `', statePath, '`');
        return true;
    }
    state = fecl.loads(fs.fopen(statePath, 'r').readAll());
    core.logger.info('loaded state from `', statePath, '`; indices: ', state.len());
    return true;
};

let saveState = fn() {
    let _ = core.logger.scopedTag('indexSaveState');
    let f = fs.fopen(statePath, 'w+');
    io.fprintln(f, fecl.dumps(state, 0, '    '));
    core.logger.info('saved state to `', statePath, '`');
    return true;
};

let isAnyIndexNotUpdated = fn() {
    let _ = core.logger.scopedTag('indexIsAnyIndexNotUpdated');
    let dirs = fs.walkDir(core.indexRoot, fs.WALK_DIRS, nameOnly = true);
    core.logger.info('checking if any index is not updated');
    if dirs.empty() {
        core.logger.warn('no index present to check');
        return true;
    }
    for indexStr in dirs.each() {
        if !isIndexUpdated(indexStr) { return true; }
    }
    return false;
};

let isIndexUpdated = fn(indexStr) {
    if !state.find(indexStr) {
        state.insert(indexStr, 0);
        saveState();
        return false;
    }
    let nowSec = time.resolve(time.now(), time.second).int();
    return nowSec - state[indexStr] < stateUpdateInterval;
};

let markIndexUpdated = fn(indexStr) {
    if !state.find(indexStr) {
        state.insert(indexStr, 0);
    }
    state[indexStr] = time.resolve(time.now(), time.second).int();
    saveState();
    return true;
};

####################################################################################################
########################################## Utilities ###############################################
####################################################################################################

# Get dir name from URL
let urlToDir = fn(url) {
    let s = url.replace('https://', '');
    return core.indexRoot / s.lower().replace('/', '@');
};

# Get URL from dir path
let dirToUrl = fn(dir) {
    return 'https://' + dir.file().str().replace('@', '/');
};

let getPkgMetaPath = fn(indexPath, name) {
    let n = name.lower();
    return indexPath / 'pkgs' / n.sub(0, 1) / (n + '.fecl');
};