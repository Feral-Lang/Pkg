let io = import('std/io');
let fs = import('std/fs');
let assert = import('std/assert');
let logging = import('std/logging');

logging.addTarget(io.stdout, logging.Levels.TRACE);

let state = import('../lib/state');

state.statePath = __SRC_DIR__ / 'state.fecl';

assert.eq(state.state.len(), 2);
assert.eq(state.load(), true);
assert.eq(state.state.len(), 2);
assert.eq(fs.exists(state.statePath), true);

assert.eq(state.getInstalled('test'), nil);
assert.eq(state.install('test', '0.0.1'), true);
assert.eq(state.getInstalled('test'), '0.0.1');
assert.eq(state.install('test', '0.0.2'), false);
assert.eq(state.setIndexTime(1), true);

assert.eq(state.load(), true);
assert.eq(state.uninstall('test', '0.0.2'), false);
assert.eq(state.uninstall('test', '0.0.1'), true);
assert.eq(state.uninstall('test', '0.0.1'), false);
assert.eq(state.getIndexTime(), 1);

fs.remove(state.statePath);