let io = import('std/io');
let fs = import('std/fs');
let os = import('std/os');
let map = import('std/map');
let vec = import('std/vec');
let logging = import('std/logging');

let core = import('./core');
let index = import('./index');
let builder = import('../builder');

let installRootDir = core.rootDir / 'installed';
let downloadDir = core.rootDir / 'downloads';

if !fs.exists(installRootDir) {
    fs.mkdir(installRootDir);
}

let getPkgDownloadPath = fn(pkgConfig) {
    return downloadDir / pkgConfig.name / pkgConfig.version;
};

let getPkgInstallPath = fn(pkgConfig) {
    return installRootDir / pkgConfig.name / pkgConfig.version;
};

let isPkgInstalled = fn(config, pkgConfig) {
    let pkgc = ref(config['installed'][pkgConfig.name]);
    if pkgc == nil { return false; }
    for item in pkgc.each() {
        if pkgConfig.version == item.0 { return true; }
    }
    return false;
};

# Auto => installed as dependency
# Manual => user installed
let addPkgToConfig = fn(config, pkgConfig, manualOrAuto) {
    if config['installed'][pkgConfig.name] == nil {
        config['installed'].insert(pkgConfig.name, map.new());
    }
    let pkgc = ref(config['installed'][pkgConfig.name]);
    if pkgConfig['disableVersionedInstallPath'] {
        # Only one version can be installed at any time.
        pkgc.clear();
    }
    if pkgc[pkgConfig.version] == nil {
        pkgc.insert(pkgConfig.version, manualOrAuto);
    } else {
        pkgc[pkgConfig.version] = manualOrAuto;
    }
};

let removePkgFromConfig = fn(config, pkgConfig) {
    let pkgc = ref(config['installed'][pkgConfig.name]);
    if pkgc == nil || pkgc[pkgConfig.version] == nil { return; }
    pkgc.erase(pkgConfig.version);
    if pkgc.empty() {
        config['installed'].erase(pkgConfig.name);
    }
};

let downloadAndInstallPackage = fn(pkgConfig, manualOrAuto, forceInstall = false, keepDownloads = false) {
    let pkgInstallPath = getPkgInstallPath(pkgConfig);
    let pkgDownloadPath = ''.path();
    if !downloadPackage(pkgConfig, pkgDownloadPath) { return false; }
    if !installPackage(pkgConfig, pkgDownloadPath, manualOrAuto, forceInstall, keepDownloads) { return false; }
    if !keepDownloads {
        fs.remove(pkgDownloadPath);
    } else {
        io.cprintln('Keeping source directory ...');
    }
    return true;
};

# downloadPath is returned (it's an out variable)
let downloadPackage = fn(pkgConfig, pkgDownloadPath) {
    pkgDownloadPath = getPkgDownloadPath(pkgConfig);
    if fs.exists(pkgDownloadPath) { fs.remove(pkgDownloadPath); }
    let cmd = core.getPkgDownloadCmd(pkgConfig, pkgDownloadPath);
    io.cprintln('Downloading to: {g}', pkgDownloadPath, '{0}');
    let outLines = vec.new(refs = true);
    if os.exec(cmd, out = outLines) != 0 || outLines.empty() {
        io.ecprintln('{r}Failed to download package: ', pkgConfig.name);
        io.ecprintln(outLines.join('-- '));
        return false;
    }
    for o in outLines.each() {
        logging.info('-- ', o);
    }
    return true;
};

let buildPackage = fn(pkgConfig, pkgSourcePath) {
    return installPackage(pkgConfig, pkgSourcePath, 'manual', false, false, true);
};

# pkgConfig => config from the index
# keepDownloads is here only to be passed to downloadAndInstallPackage
let installPackage = fn(pkgConfig, pkgSourcePath, manualOrAuto = 'manual', forceInstall = false, keepDownloads = false, buildOnly = false) {
    let config = core.loadConfig(core.rootConfigPath);
    let pkgInstallPath = getPkgInstallPath(pkgConfig);
    if !buildOnly {
        let pkgInstalled = isPkgInstalled(config, pkgConfig);
        if forceInstall && pkgInstalled {
            logging.trace('Package: ', pkgConfig.name, '[', pkgConfig.version, '] already installed, deleting...');
            io.cprintln('Package: {y}', pkgConfig.name, '{0}[{c}', pkgConfig.version, '{0}] was already installed, deleting...');
            removePkgFromConfig(config, pkgConfig);
            if fs.exists(pkgInstallPath) { fs.remove(pkgInstallPath); }
            pkgInstalled = false;
        }
        if pkgInstalled {
            logging.trace('Package: ', pkgConfig.name, '[', pkgConfig.version, '] already installed!');
            io.cprintln('Package: {y}', pkgConfig.name, '{0}[{c}', pkgConfig.version, '{0}] already installed!');
            return true;
        }
    }
    let depPaths = vec.new(refs = true);
    if pkgConfig['depends'] != nil {
        io.cprintln('Installing {y}', pkgConfig['depends'].len(), '{0} dependencies ...');
        for dep in pkgConfig.depends.each() {
            let depConfig = index.getPackageConfig(dep.0);
            if isPkgInstalled(config, depConfig) {
                logging.trace('Package: ', depConfig.name, '[', depConfig.version, '] already installed!');
                io.cprintln('Package: {y}', depConfig.name, '{0}[{c}', depConfig.version, '{0}] already installed!');
                continue;
            }
            depConfig.version = dep.1;
            if !downloadAndInstallPackage(depConfig, 'auto', false, keepDownloads) {
                return false;
            }
            depPaths.push(getPkgInstallPath(depConfig));
        }
    }
    if !buildOnly {
        if manualOrAuto == 'auto' {
            io.cprintln('Installing package dependency: {y}', pkgConfig.name, '{0}[{c}', pkgConfig.version, '{0}] ...');
        } else {
            io.cprintln('Installing package: {y}', pkgConfig.name, '{0}[{c}', pkgConfig.version, '{0}] ...');
        }
    }
    let cwd = os.getCWD();
    os.setCWD(pkgSourcePath);
    let task = 'install';
    if buildOnly { task = 'build'; }
    builder.setBuildInfo(pkgConfig.name, pkgConfig.version, pkgSourcePath, pkgInstallPath, depPaths, task);
    io.cprintln('Building ...');
    let res = builder.build();
    os.setCWD(cwd);
    if !res {
        io.cprintln('Package: {y}', pkgConfig.name, '{0} ', task, ' failed!');
        return false;
    }
    # Add depPaths to {pkgInstallPath}/.modulePaths
    # There shouldn't be any duplicates in it.
    if !depPaths.empty() {
        io.cprintln('Adding {y}', depPaths.len(), '{0} entries to module paths ...');
        let pkgModulePathsFilePath = pkgInstallPath / '.modulePaths';
        let f = fs.fopen(pkgModulePathsFilePath, 'w+');
        for p in depPaths.each() {
            io.fprintln(f, p);
        }
    }
    if !buildOnly {
        addPkgToConfig(config, pkgConfig, manualOrAuto);
        core.writeConfig(core.rootConfigPath, config);
        # Add pkgInstallPath to {feral.installPath}/lib/.modulePaths
        if manualOrAuto == 'manual' { feral.addGlobalModulePaths(pkgInstallPath); }
        io.cprintln('Package: {y}', pkgConfig.name, '{0}[{c}', pkgConfig.version, '{0}] installed successfully!');
    } else {
        io.cprintln('Package: {y}', pkgConfig.name, '{0}[{c}', pkgConfig.version, '{0}] built successfully!');
    }
    return res;
};

let removePackage = fn(pkgConfig) {
    let pkgInstallPath = getPkgInstallPath(pkgConfig);
    let config = core.loadConfig(core.rootConfigPath);
    if !fs.exists(pkgInstallPath) {
        logging.trace('Package: ', pkgConfig.name, '[', pkgConfig.version, '] is not installed');
        io.cprintln('Package: {y}', pkgConfig.name, '{0}[{c}', pkgConfig.version, '{0}] is not installed');
        return true;
    }
    removePkgFromConfig(config, pkgConfig);
    core.writeConfig(core.rootConfigPath, config);
    fs.remove(pkgInstallPath);
    # Remove pkgInstallPath from {feral.installPath}/lib/.modulePaths
    feral.removeGlobalModulePaths(pkgInstallPath);
    io.cprintln('Package: {y}', pkgConfig.name, '{0}[{c}', pkgConfig.version, '{0}] removed successfully!');
    return true;
};

