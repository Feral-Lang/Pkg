# Core variables/definitions

let fs = import('std/fs');
let os = import('std/os');
let map = import('std/map');
let vec = import('std/vec');
let fecl = import('std/fecl');
let logging = import('std/logging');

let home = feral.libPath / 'pkg';
let tmpRoot = feral.tempPath / 'pkg';
let cacheRoot = home / 'cache';
let indexRoot = home / 'indexes';
let installRoot = home / 'installed';

fs.mkdir(tmpRoot, cacheRoot, indexRoot, installRoot);

let curlCmd = os.name == 'windows' ? os.findExec('curl.exe') : os.findExec('curl');
let gitCmd = os.name == 'windows' ? os.findExec('git.exe') : os.findExec('git');
let tarCmd = os.name == 'windows' ? os.findExec('tar.exe') : os.findExec('tar');

if curlCmd == nil {
    raise('FATAL: Could not find curl in PATH. Please make sure curl is installed!');
}
if gitCmd == nil {
    raise('FATAL: Could not find git in PATH. Please make sure git is installed!');
}
if tarCmd == nil {
    raise('FATAL: Could not find tar in PATH. Please make sure tar is installed!');
}

####################################################################################################
########################################## Handlers ################################################
####################################################################################################

let handlers = map.new(refs = true);

let handle = fn(.kw, key, args...) {
    let handler = ref(handlers[key]);
    if handler == nil {
        raise('No handler for ', key, ' exists');
    }
    return handler(args..., kw...);
};

let setHandler = fn(key, handler) {
    handlers.insert(key, handler);
};

let hasHandler = fn(key) {
    return handlers.find(key);
};

####################################################################################################
########################################## Utilities ###############################################
####################################################################################################

"
  fn(name, vers, url, hash, force = false) -> Result<Path>
Downloads and extracts the archive from `url`, returning the result which wraps the path where
the archive was extracted. Deletes the archive once extracted.
"
let downloadAndExtract = fn(name, vers, url, hash, force = false) {
    let outDir = getPkgTempPath(name, vers);
    logging.info('[downloadAndExtract] downloading `', name, '@', vers, '` ...');
    let _ = logging.ScopedDepth();
    if fs.exists(outDir) {
        logging.debug('[downloadAndExtract] pkgTempPath `', outDir, '` already exists!');
        if !force { return feral.ok(outDir); }
        fs.remove(outDir);
    }
    let archivePath = getPkgArchivePath(name, vers);
    let archiveName = archivePath.file();
    if fs.exists(archivePath) {
        let actualHash = hashing.sha256File(archivePath);
        logging.debug('[downloadAndExtract] checking hash, expected: `', hash, '`, found: `', actualHash, '`');
        if actualHash != hash { fs.remove(archivePath); }
    }
    if !fs.exists(archivePath) {
        logging.info('fetching (via curl) ', name, '@', vers, ' ...');
        let out = '';
        if os.exec(out = out, curlCmd, '-sSL', '--output-dir', archivePath.parent(), url, '-o', archiveName) != 0 {
            return feral.err(-1, 'failed to download ', name, '@', vers, ' from `', url, '`:\n', out);
        }
    }
    let actualHash = hashing.sha256File(archivePath);
    if actualHash != hash {
        return feral.err(-1, 'hash mismatch when downloading ', name, '@', vers, '; given: `', hash, '`, actual: `', actualHash, '`');
    }
    fs.mkdir(outDir);
    let out = '';
    if os.exec(out = out, tarCmd, '--strip-components=1', '-C', outDir, '-x', '-f', archivePath, '^2>&1') != 0 {
        return feral.err(-1, 'failed to extract `', archivePath, '`:\n', out);
    }
    fs.remove(archivePath);
    return feral.ok(outDir);
};

let isPkgManuallyInstalled = fn(dir) {
    for e in feral.moduleDirs.each() {
        if e == dir { return true; }
    }
    return false;
};

let loadPkgScriptIn = fn(dir, configInfo) {
    let scriptPath = getPkgScriptPath(dir);
    if !fs.exists(scriptPath) {
        return feral.err(-1, 'could not find package script `', scriptPath, '`');
    }
    let script = import(scriptPath.str().replace('.fer', ''));
    if !script._hasAttr_('configure') {
        return feral.err(-1, 'could not find a function `configure(configInfo)` in script `', scriptPath, '`');
    }
    return script.configure(configInfo);
};

let loadLockFileIn = fn(dir) {
    let path = getPkgLockPath(dir);
    if !fs.exists(path) {
        return feral.err(-1, 'could not find package lock file `', path, '`');
    }
    return feral.ok(fecl.loads(fs.fopen(path, 'r').readAll()));
};

let getPkgCachePath = fn(name, vers) {
    return cacheRoot / (name.lower() + '--' + vers);
};

let getPkgInstallPath = fn(name, vers) {
    return installRoot / (name.lower() + '--' + vers);
};

let getPkgTempPath = fn(name, vers) {
    return tmpRoot / (name.lower() + '--' + vers);
};

let getPkgArchivePath = fn(name, vers) {
    return tmpRoot / (name.lower() + vers + '.zip');
};

let getPkgLockPath = fn(dir) {
    return dir / 'package.lock';
};

let getPkgScriptPath = fn(dir) {
    return dir / 'package.fer';
};
