let vec = import('std/vec');
let package = import('std/package');

let configure = fn(info) {
    let pkg = package.new(
        'Pkg',
        desc = 'Feral package manager',
        version = '0.2.0',
        feral = '>=2.0.1',
        authors = vec.new(
            'Electrux'
        )
    );

    return feral.ok(pkg);
};